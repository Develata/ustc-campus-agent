{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Develata/ustc-campus-agent/market/schemas/plugin-package.schema.json",
  "title": "USTC Campus Agent PluginPackage",
  "type": "object",
  "required": [
    "id",
    "version",
    "publisher",
    "tier",
    "displayName",
    "implementationStatus",
    "installPolicy",
    "components",
    "capabilities",
    "sourcePolicy"
  ],
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$"
    },
    "version": {
      "type": "string",
      "pattern": "^0\\.[0-9]+\\.[0-9]+$|^[1-9][0-9]*\\.[0-9]+\\.[0-9]+$"
    },
    "publisher": {
      "type": "string"
    },
    "tier": {
      "enum": [
        "FirstParty",
        "VerifiedCommunityText",
        "VerifiedRemoteMcp"
      ]
    },
    "displayName": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "implementationStatus": {
      "enum": [
        "planned",
        "development",
        "implemented"
      ]
    },
    "installPolicy": {
      "type": "object",
      "required": [
        "class",
        "defaultInstalled",
        "defaultEnabled",
        "userDisableAllowed"
      ],
      "additionalProperties": false,
      "properties": {
        "class": {
          "enum": [
            "FirstPartySystemPlugin",
            "UserInstalledPlugin"
          ]
        },
        "defaultInstalled": {
          "type": "boolean"
        },
        "defaultEnabled": {
          "type": "boolean"
        },
        "userDisableAllowed": {
          "type": "boolean"
        }
      }
    },
    "components": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "type",
          "path"
        ],
        "additionalProperties": false,
        "properties": {
          "type": {
            "enum": [
              "SkillComponent",
              "DeclarativeResourcePack",
              "McpServerComponent",
              "NativeRustComponent"
            ]
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "mode": {
            "type": "string"
          }
        }
      }
    },
    "capabilities": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "sourcePolicy": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
